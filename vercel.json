{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/api$",
      "dest": "https://kisha-volcanologic-motherly.ngrok-free.dev/api",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "ngrok-skip-browser-warning" },
          "args": "1"
        }
      ]
    },
    {
      "src": "/api/(.*)",
      "dest": "https://kisha-volcanologic-motherly.ngrok-free.dev/api/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "ngrok-skip-browser-warning" },
          "args": "1"
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
