NODE_ENV=development
HOST=127.0.0.1
PORT=4173

# Local development defaults to SQLite. Production requires the Neon pair below.
DATABASE_FILE=./data/crewos.sqlite
DATABASE_POOL_MAX=10
# To use Neon locally or in production, use the pooled Postgres URL and Auth endpoint
# from the same Neon branch and database. The Auth URL ends in /auth.
DATABASE_URL=
NEON_AUTH_BASE_URL=
# Leave blank locally; set to the public app origin in deployment.
APP_ORIGIN=
# Blank auto-secures cookies in production or on direct HTTPS; set true behind a TLS proxy in development.
COOKIE_SECURE=
# Required to encrypt integration secrets stored in workspace settings.
APP_MASTER_KEY=

# Optional Shopify app OAuth setup. Leave all blank to keep external authorization unavailable.
# Callback must be a public HTTPS URL ending in /api/commerce/v2/shopify/oauth/callback.
# OAuth asks only for read_products; catalog mutations and publishing remain disabled.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_OAUTH_CALLBACK_URL=
SHOPIFY_ADMIN_API_VERSION=2026-10

# Development LLM traffic uses this OpenAI-compatible endpoint; cloud keys are not used in development.
DEV_LLM_BASE_URL=http://127.0.0.1:8317/v1
DEV_LLM_CONTAINER_BASE_URL=
DEV_LLM_API_KEY=
# Use a model ID returned by the local endpoint's /models route.
DEV_LLM_MODEL=gpt-6-luna
DEV_LLM_EMBEDDING_MODEL=
DEV_LLM_TRANSCRIPTION_MODEL=
DEV_LLM_EVALUATOR_MODEL=

# Production model and provider configuration. Workspace settings can store OpenRouter/Solari keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Must match the configured Pinecone index's vector dimension (e.g. 1024 for Pinecone's own hosted-embedding default indexes); leave blank to use the model's native size.
OPENROUTER_EMBEDDING_DIMENSIONS=
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1
OPENROUTER_EVALUATOR_MODEL=
SOLARI_API_KEY=
SOLARI_BASE_URL=
SOLARI_BROWSER_BASE_URL=
TINY_FISH_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_API_KEY=

# Optional Jira Cloud OAuth 2.0 (3LO) server configuration.
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
ATLASSIAN_OAUTH_REDIRECT_URI=

# Optional trusted operator verifier; MCP tool dispatch stays blocked when unset.
MCP_VERIFIER_MODULE=

# Optional model-token price overrides, keyed by provider/model; rates are USD per million tokens.
PROVIDER_PRICING_JSON={}

# Optional Python executable used for PDF/DOCX extraction (defaults to python3).
PYTHON=python3

# Optional CrewOS CLI credentials; keep these local.
CREWOS_URL=http://127.0.0.1:4173
CREWOS_EMAIL=
CREWOS_PASSWORD=

# Optional backend/scripts/stress-workflows.mjs parameters; run with --confirm-simulated-workflows.
STRESS_WORKFLOW_COUNT=16
STRESS_POLL_TIMEOUT_MS=300000
STRESS_POLL_INTERVAL_MS=100

# Pilot release: production defaults to true; local development defaults to false.
PILOT_MODE=false
# api, worker, or combined (default). Production Compose runs separate processes.
PROCESS_ROLE=combined
# Organization Engine V2 is independently default-off. Add only explicitly opted-in org IDs.
CREWOS_ORG_ENGINE_V2=false
CREWOS_ORG_ENGINE_V2_ORGS=
# Runs the local simulated paid-order → primary employee → coworker review flow.
# Requires V2 enabled for the org; external provider effects remain disabled.
CREWOS_EVENT_RESPONSE_MVP=false
# Local signed fixtures are disabled by default and never work with production connections.
CREWOS_LOCAL_WEBHOOK_FIXTURES=false
CREWOS_LOCAL_WEBHOOK_FIXTURE_SECRET=
# Sarvam live browser SDK proxy is disabled by default; API keys are saved encrypted per connection.
# This does not enable outbound dialing; that remains blocked without a supported callback verifier.
SARVAM_LIVE_ENABLED=false
# Local-only simulated Sarvam sessions/callbacks require this and CREWOS_LOCAL_WEBHOOK_FIXTURES=true.
SARVAM_LOCAL_FIXTURES=false
# Optional server-side browser voice app binding. IDs/version are used by manager Voice setup;
# SARVAM_API_KEY remains server-side and is encrypted onto the workspace connection.
SARVAM_ENVIRONMENT=staging
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=
SARVAM_VOICE_MODEL=
SARVAM_LANGUAGES=en-IN
# Native Slack app (separate from saved Solari browser logins).
# OAuth callback: APP_ORIGIN/oauth/slack/callback
# Slash command request URL: APP_ORIGIN/api/slack/commands
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
